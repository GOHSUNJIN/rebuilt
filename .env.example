# Get your API key at https://resend.com (free up to 3,000 emails/month)
# Add this to Vercel: Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin login — set these in Vercel env vars (never commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong
ADMIN_SECRET=replace-with-random-32-char-string

# Vercel Analytics API — required for the /admin dashboard
# API token: vercel.com/account/tokens (read access is sufficient)
# Project ID: vercel.com/dashboard → your project → Settings → General
# Team ID: only needed for team accounts (vercel.com/teams → settings)
VERCEL_ACCESS_TOKEN=your_vercel_access_token
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx
